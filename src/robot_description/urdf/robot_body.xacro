<?xml version="1.0" encoding="utf-8"?>
<robot name="diff_drive_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<link name="base_footprint"/>

<link name="base_link">

<xacro:inertial_box mass="6.5" x="0.35" y="0.22" z="0.16">
<origin xyz="0 0 0.08" rpy="0 0 0"/>
</xacro:inertial_box>

<visual>
<origin xyz="0 0 0.05" rpy="0 0 0"/>
<geometry>
<box size="0.30 0.30 0.15"/>
</geometry>
<material name="blue">
<color rgba="0.2 0.2 0.8 1"/>
</material>
</visual>

<collision>
<origin xyz="0 0 0.05" rpy="0 0 0"/>
<geometry>
<box size="0.30 0.30 0.15"/>
</geometry>
</collision>

</link>

<joint name="base_joint" type="fixed">
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
</joint>

<link name="right_wheel_link">

<xacro:inertial_cylinder mass="0.5" length="0.02" radius="0.05">
<origin xyz="0 0 0" rpy="0 0 0"/>
</xacro:inertial_cylinder>

<visual>
<origin xyz="0 0 0" rpy="1.57 0 0"/>
<geometry>
    <cylinder radius="0.05" length="0.03"/>
</geometry>
<material name="black">
    <color rgba="0.0 0.0 0.0 1"/>
</material>
</visual>

<collision>
    <origin xyz="0 0 0" rpy="1.57 0 0"/>
    <geometry>
        <sphere radius="0.05"/>
    </geometry>
</collision>

</link>

<joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 -0.17 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.6" friction="0.2"/>
</joint>

<link name="left_wheel_link">

<xacro:inertial_cylinder mass="0.5" length="0.02" radius="0.05">
<origin xyz="0 0 0" rpy="0 0 0"/>
</xacro:inertial_cylinder>

<visual>
<origin xyz="0 0 0" rpy="1.57 0 0"/>
<geometry>
    <cylinder radius="0.05" length="0.03"/>
</geometry>
<material name="black">
    <color rgba="0.0 0.0 0.0 1"/>
</material>
</visual>

<collision>
    <origin xyz="0 0 0" rpy="1.57 0 0"/>
    <geometry>
        <sphere radius="0.05"/>
    </geometry>
</collision>

</link>

<joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 0.17 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.6" friction="0.2"/>
</joint>

<link name="front_caster_wheel_link">

<xacro:inertial_sphere mass="0.15" radius="0.05">
<origin xyz="0 0 0" rpy="0 0 0"/>
</xacro:inertial_sphere>

<visual>
<origin xyz="0 0 0" rpy="1.57 0 0"/>
<geometry>
    <sphere radius="0.0495" />
</geometry>
<material name="black">
    <color rgba="0.0 0.0 0.0 1"/>
</material>
</visual>

<collision>
<origin xyz="0 0 0" rpy="1.57 0 0"/>
<geometry>
    <sphere radius="0.0495" />
</geometry>
</collision>

</link>

<joint name="front_caster_wheel_joint" type="fixed">
<origin xyz="0.10 0 0" rpy="0 0 0"/>
<parent link="base_link"/>
<child link="front_caster_wheel_link"/>
</joint>

<link name="back_caster_wheel_link">

<xacro:inertial_sphere mass="0.15" radius="0.05">
<origin xyz="0 0 0" rpy="0 0 0"/>
</xacro:inertial_sphere>

<visual>
<origin xyz="0 0 0" rpy="1.57 0 0"/>
<geometry>
    <sphere radius="0.0495" />
</geometry>
<material name="black">
    <color rgba="0.0 0.0 0.0 1"/>
</material>
</visual>

<collision>
<origin xyz="0 0 0" rpy="1.57 0 0"/>
<geometry>
    <sphere radius="0.0495" />
</geometry>
</collision>

</link>

<joint name="back_caster_wheel_joint" type="fixed">
<origin xyz="-0.10 0 0" rpy="0 0 0"/>
<parent link="base_link"/>
<child link="back_caster_wheel_link"/>
</joint>

<link name="imu_link">
    <xacro:inertial_box mass="0.001" x="0.04" y="0.04" z="0.005">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>

    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <geometry>
            <box size="0.04 0.04 0.005"/>
        </geometry>

        <material name="red">
            <color rgba="0.8 0.1 0.1 1"/>
        </material>

    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <geometry>
            <box size="0.04 0.04 0.005"/>
        </geometry>

    </collision>
</link>

<joint name="imu_joint" type="fixed">
<origin xyz="0 0 0.10" rpy="0 0 0"/>
<parent link="base_link" />
<child link="imu_link" />
<axis xyz="0 0 0" />
</joint>

<link name="laser_link">

<xacro:inertial_cylinder mass="0.005" length="0.02" radius="0.05">
<origin xyz="0 0 0" rpy="0 0 0"/>
</xacro:inertial_cylinder>

<visual>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
    <cylinder radius="0.05" length="0.03"/>
</geometry>
<material name="black">
    <color rgba="0.0 0.0 0.0 1"/>
</material>
</visual>

<collision>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
    <cylinder radius="0.05" length="0.03"/>
</geometry>
</collision>

</link>

<joint name="laser_joint" type="fixed">
<origin xyz="0 0 0.145" rpy="0 0 0"/>
<parent link="base_link"/>
<child link="laser_link"/>
</joint>


</robot>